# Copie este archivo a .env y complete los valores antes de ejecutar docker compose up -d
# NUNCA versione el archivo .env real ni comparta estos valores.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SU_PASSWORD_POSTGRES>
POSTGRES_DB=girasoles_db

ASPNETCORE_ENVIRONMENT=Production

# Clave aleatoria criptográfica de al menos 32 caracteres
JWT_SECRET_KEY=<SU_CLAVE_JWT_ALEATORIA_MINIMO_32_CARACTERES>
JWT_ISSUER=GirasolesRes
JWT_AUDIENCE=GirasolesResApp
JWT_EXPIRACION_MINUTOS=30

# Consulta externa DNI/RUC (ApisPeru)
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=<SU_TOKEN_APISPERU>

# Servicio de correo transaccional (Mailjet API v3.1)
EMAIL_API_KEY=<SU_API_KEY_MAILJET>
EMAIL_SECRET_KEY=<SU_SECRET_KEY_MAILJET>
EMAIL_FROM_EMAIL=no-reply@girasolesres.pp.ua
EMAIL_FROM_NAME=Restaurante Girasoles
EMAIL_DESTINATARIO_PRUEBA=

# Sembrado inicial de usuarios (deshabilitado por defecto en Production)
SEED_HABILITADO=false
SEED_PASSWORD_INICIAL=
