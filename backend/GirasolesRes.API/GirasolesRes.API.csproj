    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GirasolesRes.Application\GirasolesRes.Application.csproj" />
    <ProjectReference Include="..\GirasolesRes.Infrastructure\GirasolesRes.Infrastructure.csproj" />
  </ItemGroup>

</Project>
