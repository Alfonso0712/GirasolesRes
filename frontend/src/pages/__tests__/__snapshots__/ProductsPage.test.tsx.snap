              aria-label="Página siguiente"
              class="p-2 min-h-[38px] min-w-[38px] rounded-xl border border-neutral-200/90 bg-surface hover:bg-neutral-100 disabled:opacity-40 disabled:cursor-not-allowed text-neutral-700 transition-colors shadow-2xs flex items-center justify-center cursor-pointer active:scale-95"
              disabled=""
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-chevron-right w-4 h-4"
                fill="none"
                height="24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="m9 18 6-6-6-6"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
